{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "installCommand": "npm ci",
    "buildCommand": "npm run build",
    "outputDirectory": "public",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.6.2",
            "excludeFiles": "{node_modules,assets,docs,tests,.git,.github,.vercel}/**"
        }
    },
    "routes": [
        { "src": "/index.php", "dest": "/api/index.php" },
        { "handle": "filesystem" },
        { "src": "/(.*)", "dest": "/api/index.php" }
    ],
    "env": {
        "APP_NAME": "SAYA Wedding Organizer",
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "APP_CONFIG_CACHE": "/tmp/saya-config.php",
        "APP_EVENTS_CACHE": "/tmp/saya-events.php",
        "APP_PACKAGES_CACHE": "/tmp/saya-packages.php",
        "APP_ROUTES_CACHE": "/tmp/saya-routes.php",
        "APP_SERVICES_CACHE": "/tmp/saya-services.php",
        "SESSION_DRIVER": "array",
        "CACHE_STORE": "array",
        "QUEUE_CONNECTION": "sync",
        "LOG_CHANNEL": "stderr",
        "WEDDING_PREVIEW": "true",
        "WEDDING_WHATSAPP_NUMBER": "628153000713",
        "WEDDING_INSTAGRAM_URL": "https://www.instagram.com/saya.wedding/"
    }
}
